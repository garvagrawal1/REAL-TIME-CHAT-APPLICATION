# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/chatflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chatflow_ai

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_chatflow_ai_2026_production_safe
JWT_EXPIRES_IN=7d

# CORS Client Allowed Origin
CLIENT_URL=http://localhost:5173

# AI Configuration (Server-Side Only - Never Exposed To Frontend)
# Supported: Google Gemini API Key / OpenAI Key
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini
